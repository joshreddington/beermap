rules_version = '2';

// Each signed-in user owns exactly one document at locations/{uid} holding
// their current shared position. Only they can write it. It's only
// readable by themselves or by another signed-in user whose uid they've
// explicitly added to sharedWith (mutual, revocable, opt-in pairing --
// there is no discovery or global read of who's sharing).
service cloud.firestore {
  match /databases/{database}/documents {
    match /locations/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid ||
         request.auth.uid in resource.data.get('sharedWith', []));
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
